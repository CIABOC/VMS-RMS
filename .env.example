# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL
DB_NAME=ciaboc_rvm
DB_USER=rvm
DB_PASSWORD=change-me
DB_PORT=5432

# --- Authentication
# dev = SSO not merged yet; staff sign in with their e-mail on the sign-in page (no passwords)
# sso = only Single Sign-On is accepted (set once SSO is merged)
APP_AUTH_MODE=dev
APP_SSO_LOGIN_URL=
# First System Administrator, created only when the staff table is empty
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_NAME=System Administrator

# --- General
APP_TIME_ZONE=Asia/Colombo
# true behind HTTPS (production)
SESSION_COOKIE_SECURE=false
WEB_PORT=8081
